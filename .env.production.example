# -----------------------------------------------------------------------------
# Environnement de production — c2me.fr
#
# Copier vers .env sur le serveur, puis compléter les valeurs marquées
# « à renseigner ». Ne jamais versionner le fichier final.
#
#   cp .env.production.example .env
#   php artisan key:generate
# -----------------------------------------------------------------------------

# Application
# APP_DEBUG doit rester à false : en true, les pages d'erreur exposent les
# variables d'environnement, dont le mot de passe de la base et du back-office.
APP_NAME=C2ME
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://c2me.fr
# Version affichée à côté du logo du back-office (Filament App Version).
# À incrémenter à chaque mise en production.
APP_VERSION=1.0.0

APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=12

# Journalisation
# Les échecs d'envoi d'e-mail sont remontés par report() : passer sous
# « warning » les rendrait invisibles.
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base de données — à renseigner
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=c2me
DB_USERNAME=
DB_PASSWORD=

# Session et cache
# SESSION_SECURE_COOKIE empêche l'envoi du cookie hors HTTPS : à conserver
# tant que le site est bien servi en TLS.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log

# Redis — optionnel
# Présent dans composer.json, mais rien n'exige Redis aujourd'hui : passez
# CACHE_STORE=redis et SESSION_DRIVER=redis pour l'activer.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Stockage
# Les plans déposés restent sur ce disque : le répertoire storage/app doit
# persister entre deux déploiements et ne jamais être servi en public.
FILESYSTEM_DISK=local

# Courrier — relais SMTP Orange (c2me.fr) — à renseigner
# Sans cela, les demandes arrivent bien dans le back-office mais aucune
# alerte n'est envoyée. Vérifier au préalable les enregistrements SPF, DKIM
# et DMARC du domaine : depuis une IP de datacentre, un message non signé
# est classé en indésirable.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@c2me.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Back-office Filament — obligatoire
# Aucune valeur de repli : sans cette clé, db:seed refuse de créer le compte
# plutôt que d'ouvrir le back-office avec un mot de passe présent dans le
# dépôt.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Nom affiché par Vite dans les bundles front
VITE_APP_NAME=C2ME
